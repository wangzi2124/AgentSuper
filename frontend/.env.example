# 前端部署环境变量（Vite 构建时注入）。复制为 .env.production 并按需修改。

# 前后端分开部署（跨域）时填后端地址，例如：
#   VITE_API_BASE=https://api.example.com
# 留空 = 同源（前端和 /api 走同一个域名 + 反向代理，推荐）。
VITE_API_BASE=

# 后端 .env 配了 ADMIN_TOKEN 时，前端管理操作需带同一个令牌，否则远程管理接口 403。
# 留空 = 后端未启用 ADMIN_TOKEN（仅 localhost 可管理）。
VITE_ADMIN_TOKEN=

# 语音 TTS（可选，默认走同源 /api/voice）
VITE_TTS_BASE=
VITE_TTS_SPEAKER=Vivian
