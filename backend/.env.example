# ===========================================
# LLM Configuration
# ===========================================
# For DeepSeek:
#   LLM_MODEL=deepseek/deepseek-v4-flash   (推荐)
#   LLM_MODEL=deepseek/deepseek-v4-pro
#   LLM_API_KEY=sk-your-deepseek-key
#   LLM_API_BASE=https://api.deepseek.com
#
# For OpenAI:
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_KEY=sk-your-openai-key
#   LLM_API_BASE=
#
# For Ollama (local):
#   LLM_MODEL=ollama/qwen2.5:7b
#   LLM_API_KEY=
#   LLM_API_BASE=http://localhost:11434
#
# 注意: deepseek-chat / deepseek-reasoner 将于 2026/07/24 弃用
# ===========================================
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=https://api.deepseek.com

# ===========================================
# Local Embedding (sentence-transformers)
# No API key needed, runs locally
# - all-MiniLM-L6-v2 (English only, default)
# - BAAI/bge-small-zh-v1.5 (Chinese, recommended for Chinese docs)
# To use a local downloaded model, set a local directory path:
# EMBEDDING_MODEL=data/models/all-MiniLM-L6-v2
# If network access is unavailable, the code will try this local path first.
# Download the model from:
# https://modelscope.cn/models/sentence-transformers/all-MiniLM-L6-v2/feedback
# ===========================================
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===========================================
# RAG Configuration
# ===========================================
VECTOR_STORE_PATH=data/vector_store
UPLOAD_DIR=data/uploads
CHUNK_SIZE=500
CHUNK_OVERLAP=200

# 单次请求最大工具调用轮数（每轮 = 一次完整 LLM 调用），默认 24
# MAX_TOOL_ROUNDS=24

# 每次 LLM 调用的输出 token 上限（默认 16384）。长任务配合系统提示"长内容写文件"规则避免截断。
# LLM_MAX_TOKENS=16384

# ===========================================
# Reranker (Cross-encoder)
# Model auto-downloaded via ModelScope on first run
# Set ENABLE_RERANKER=false to disable
# ===========================================
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ===========================================
# Skills & Plugins
# ===========================================
SKILLS_DIR=skills
PLUGINS_DIR=plugins

# ===========================================
# TAVILY
# ===========================================
TAVILY_API_KEY=your-tavily-api-key

# ===========================================
# Summarization (optional, for hierarchical context compression)
# Requires a separate small/cheap model for summarization.
# If unset, falls back to simple truncation.
# Recommended free options:
#   Local:   ollama/qwen2.5:3b  (~1.7GB, great for Chinese, needs Ollama running)
#   Free API: gemini/gemini-2.0-flash-lite  (1500 req/day, needs GEMINI_API_KEY)
#   Free API: groq/llama3-8b-8192          (30 req/min, needs GROQ_API_KEY)
#
# For non-DeepSeek models, set separate API key/base:
#   SUMMARIZATION_API_KEY=your-gemini-or-groq-key
#   SUMMARIZATION_API_BASE=  (leave empty for gemini/groq, litellm auto-detects)
# ===========================================
# SUMMARIZATION_MODEL=ollama/qwen2.5:3b
# SUMMARIZATION_API_KEY=
# SUMMARIZATION_API_BASE=
# SUMMARIZATION_KEEP_MESSAGES=20
# CHUNK_PAIRS=10

# ===========================================
# Context budget & compaction (aligned with opencode)
# usable = MAX_CONTEXT_TOKENS - CONTEXT_RESERVE_TOKENS
# ===========================================
# 单次 LLM 调用的上下文上限（默认 64000）
# MAX_CONTEXT_TOKENS=64000
# 输出预留 token（默认 8192）
# CONTEXT_RESERVE_TOKENS=8192
# 压缩触发阈值；0 = 自动（0.8 × usable）
# COMPACTION_THRESHOLD_TOKENS=0
# 压缩保留的最近轮次（默认 2）
# CONTEXT_TAIL_TURNS=2
# 尾部保留 token 预算（默认 8000）
# CONTEXT_PRESERVE_RECENT_TOKENS=8000
# 工具输出回溯清理：保护下限 / 生效下限（默认 40000 / 20000）
# TOOL_OUTPUT_PROTECT_TOKENS=40000
# TOOL_OUTPUT_PRUNE_MINIMUM_TOKENS=20000

# ===========================================
# Permission & workspace (aligned with opencode external_directory)
# ===========================================
# 可写工作目录由前端页面右上角「工作目录」面板配置（运行时生效，持久化于 data/runtime_workspaces.json），
# 无需在此配置，也无需重启。此处不再支持 EXTRA_WORKSPACES 环境变量。
# external 路径（工作区之外）默认策略：ask | allow | deny
# EXTERNAL_PATH_DEFAULT=ask
# 权限审批等待超时（秒），超时视为拒绝（默认 60）
# PERMISSION_APPROVAL_TIMEOUT=60

# ===========================================
# Agent execution loop guards (aligned with opencode prompt.ts / processor.ts / max-steps.ts)
# ===========================================
# 主步骤上限（对齐 opencode agent.steps），默认 40；生效上限 = min(MAX_STEPS, MAX_TOOL_ROUNDS)。
# 到达上限前的最后一轮以 assistant 角色注入收尾提示并禁用工具，强制"已完成/未完成/下一步"式总结。
# MAX_STEPS=40
# 硬兜底：单次请求内最多 LLM 调用轮数（每轮都是一次完整 LLM 调用），默认 24
# MAX_TOOL_ROUNDS=24
# Doom-loop 检测阈值：同一组工具调用指纹连续重复 N 轮后注入策略变更提示（≥2，默认 3）
# DOOM_LOOP_THRESHOLD=3
# Doom-loop 升级：首次提示后再次连续触发 N 次相同指纹即强制收尾（注入 MAX_STEPS_PROMPT + 禁用工具，默认 2）
# DOOM_LOOP_MAX_STRIKES=2
# 工具密集型子 Agent（如 code）的更长等待超时（秒），避免长任务被误判超时（默认 300）
# SUB_AGENT_TIMEOUT_EXTENDED=300
# 使用 extended 超时的子 Agent 列表（逗号分隔，默认 code）
# EXTENDED_TIMEOUT_AGENTS=code