# ===========================================
# LLM Configuration
# ===========================================
# For DeepSeek:
#   LLM_MODEL=deepseek/deepseek-v4-flash   (推荐)
#   LLM_MODEL=deepseek/deepseek-v4-pro
#   LLM_API_KEY=sk-your-deepseek-key
#   LLM_API_BASE=https://api.deepseek.com
#
# For OpenAI:
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_KEY=sk-your-openai-key
#   LLM_API_BASE=
#
# For Ollama (local):
#   LLM_MODEL=ollama_chat/qwen2.5:7b  (推荐使用 ollama_chat/ 前缀，工具调用兼容性更好)
#   LLM_API_KEY=
#   LLM_API_BASE=http://localhost:11434
#   OLLAMA_API_BASE=http://localhost:11434  (可选：显式设置，与 api_base 双保险)
#
# 注意: deepseek-chat / deepseek-reasoner 将于 2026/07/24 弃用
# 注意: ollama/ 前缀仍可用但流式工具调用有已知问题，建议使用 ollama_chat/
# ===========================================
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=https://api.deepseek.com

# ===========================================
# Local Embedding (sentence-transformers)
# No API key needed, runs locally
# - all-MiniLM-L6-v2 (English only, default)
# - BAAI/bge-small-zh-v1.5 (Chinese, recommended for Chinese docs)
# To use a local downloaded model, set a local directory path:
# EMBEDDING_MODEL=data/models/all-MiniLM-L6-v2
# If network access is unavailable, the code will try this local path first.
# Download the model from:
# https://modelscope.cn/models/sentence-transformers/all-MiniLM-L6-v2/feedback
# ===========================================
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===========================================
# Database backend for the 4 SQLite subsystems
# (session.db / model_catalog.db / chapter_store.db / tasks.db -> single shared DB)
# ChromaDB vector store is NOT affected by these settings.
# ===========================================
# 默认 sqlite：沿用原有 4 个独立 SQLite 文件，无需任何配置。
# 切换到 MySQL / PostgreSQL 后，四个子系统共用同一个数据库（ChromaDB 仍独立）：
#   1) 首次启动自动执行 Alembic 迁移建表（backend/alembic/versions/*.py）
#   2) URL 由下方组件拼装；也可用 DB_URL 直接给完整 SQLAlchemy URL 覆盖拼装
#   3) 切换为 MySQL 时建表语句为 InnoDB / utf8mb4，任务表自增/时间列语义一致
# DB_TYPE=mysql           # sqlite | mysql | postgresql
# DB_URL=                 # 可选，如 mysql+pymysql://user:pass@host:3306/db?charset=utf8mb4
# DB_HOST=127.0.0.1
# DB_PORT=0               # 0 = 默认（mysql 3306 / postgresql 5432）
# DB_USERNAME=root
# DB_PASSWORD=
# DB_NAME=agentsuper
# ===========================================

# ===========================================
# 会话持久化（SessionStore 落库 + 图检查点）
# ===========================================
# 会话元数据/逻辑删除/压缩基线写 session.db（可用 SESSION_DB_PATH 换路径，默认 data/session.db）。
# 图检查点（会话消息、对话上下文、fork/revert 状态）默认持久化到 data/checkpoints.db，
# 跨重启存活；设 CHECKPOINT_PERSIST=false 可退回进程内 MemorySaver（重启即丢，仅调试用）。
# SESSION_DB_PATH=data/session.db
# CHECKPOINT_DB_PATH=data/checkpoints.db
# CHECKPOINT_PERSIST=true
# POSTGRES_CHECKPOINT_URL=   # 可选：postgres://user:pass@host/db，启用 PostgresSaver（需 psycopg）
# ===========================================

# ===========================================
# RAG Configuration
# ===========================================
VECTOR_STORE_PATH=data/vector_store
CHUNK_SIZE=500
CHUNK_OVERLAP=200

# ===========================================
# Vector store / Chapter store cleanup
# ===========================================
# 启动时清空全部知识库数据（向量库 + 章节库 + BM25 + 上传文件），默认 false
# VECTOR_STORE_AUTO_CLEAR=false
# 数据保留天数（TTL）：>0 时按文档创建时间定期清理过期数据；0 = 不启用（默认）
# VECTOR_STORE_TTL_DAYS=0
# 定时清理检查间隔（小时），配合 VECTOR_STORE_TTL_DAYS 使用（默认 24）
# VECTOR_STORE_CLEANUP_INTERVAL_HOURS=24
# 也可通过接口手动清空：POST /api/vectors/clear（全部）或 POST /api/vectors/clear-expired（TTL）

# 每次 LLM 调用的输出 token 上限（默认 32000，对齐 opencode OUTPUT_TOKEN_MAX）。
# ⚠ 只改这里可能无效 —— resolve_max_output_tokens 取 min(模型目录声明, 本值) 且绝不放大，
# 模型目录的 limits.max_output_tokens 才是天花板；输出预留须 ≥ 本值，否则历史窗口被输出挤没。
# 默认 32000（曾 16384 / 8192）。
# LLM_MAX_TOKENS=32000

# DeepSeek V4 思考开关：enabled / disabled / adaptive，默认 disabled。
# agentic 工具循环里思考会吃光 max_tokens 预算（reasoning == ct == 上限，finish=length，
# 零工具 / 零正文）；关闭后 finish=stop、正常产出。litellm 顶层传 disabled 会被丢弃，
# 实际经 extra_body={"thinking":{"type":"disabled"}} 下发（见 catalog.litellm_extra_kwargs）。
# DEEPSEEK_THINKING=disabled

# Ollama 全局思考开关（可选兜底默认）：优先用前端「模型管理 → 思考模式」的每模型配置，
# 此处一般无需设置。enabled / disabled / adaptive，默认 disabled。
# litellm+ollama 下 think=True 会把最终回答全塞进 reasoning_content、content 恒空
# （工具调用也进 reasoning，工具循环报废），与 DeepSeek 同理故默认关闭；
# disabled→think=False（干净 content + 标准 tool_calls），enabled→think=True，adaptive→不下发。
# 仅对声明了 reasoning 能力的模型或在前端显式设了「思考模式」的模型生效（如 ollama_chat/qwen3.5:4b）。
# OLLAMA_THINKING=disabled

# Ollama 上下文窗口（num_ctx，传给本地推理服务的 options）。
# Ollama 自身默认 2048，超出窗口的 prompt 会被服务器截断 → 历史/长上下文静默丢失
# （模型答"记不清/无历史"）。按本机内存/显存调大：3090 可 32768，4090 可 65536，默认 8192。
# 注意：实际 num_ctx = min(本值, 模型条目声明的 context_length)，不会放大。
# OLLAMA_NUM_CTX=32768

# Ollama 服务端环境变量（⚠ 由独立的 `ollama serve` 进程读取，必须设为**操作系统环境变量**
# 后重启 ollama 才生效；后端 .env 注入只影响本进程，不会传给 Ollama 服务）。
#   OLLAMA_KEEP_ALIVE=-1      模型常驻内存，避免被卸载后重新加载（CPU 上 8B 加载 ~5GB 很慢）
#   OLLAMA_FLASH_ATTENTION=1  启用 Flash Attention，长上下文推理更快
# 设置方式（Windows 用户级，然后重启 ollama：ollama app.exe / ollama serve）：
#   [Environment]::SetEnvironmentVariable("OLLAMA_KEEP_ALIVE","-1","User")
#   [Environment]::SetEnvironmentVariable("OLLAMA_FLASH_ATTENTION","1","User")
# 本机小模型建议：「模型管理」页的 small_model（标题/摘要等内部轻量任务）指向小模型
# （如 ollama_chat/qwen2.5:3b，本机 CPU 实测 ~12 tok/s），不要用 8B 级模型跑后台轻量任务。

# ===========================================
# Reranker (Cross-encoder)
# Model auto-downloaded via ModelScope on first run
# Set ENABLE_RERANKER=false to disable
# ===========================================
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ===========================================
# Plugins
# ===========================================
PLUGINS_DIR=plugins

# ===========================================
# TAVILY
# ===========================================
TAVILY_API_KEY=your-tavily-api-key

# ===========================================
# Summarization (optional, for hierarchical context compression)
# Requires a separate small/cheap model for summarization.
# If unset, falls back to simple truncation.
# Recommended free options:
#   Local:   ollama_chat/qwen2.5:3b  (~1.7GB, great for Chinese, needs Ollama running)
#   Free API: gemini/gemini-2.0-flash-lite  (1500 req/day, needs GEMINI_API_KEY)
#   Free API: groq/llama3-8b-8192          (30 req/min, needs GROQ_API_KEY)
# ===========================================
# SUMMARIZATION_MODEL=ollama_chat/qwen2.5:3b
# SUMMARIZATION_KEEP_MESSAGES=20

# ===========================================
# Context budget & compaction
# ⚠ 已删旋钮（2026-10-18 审计，全库无读者）：MAX_CONTEXT_TOKENS / CONTEXT_RESERVE_TOKENS。
#   原 usable = MAX_CONTEXT_TOKENS − min(CONTEXT_RESERVE_TOKENS, 窗口一半) 的预算封顶
#   随 app/context/budget.py 目录重构一并删除。现压缩阈值是 cognition/compressor.py
#   的模块常量 COMPRESS_THRESHOLD=80_000 / KEEP_RECENT_TOKENS=20_000（非配置项，改代码才生效）。
# ===========================================
# 压缩保留的最近轮次（默认 2）
# CONTEXT_TAIL_TURNS=2
# 自动压缩时保留的最近消息条数（0 = 按 CONTEXT_TAIL_TURNS × 2 折算）。
# 必须有界：tail 全留会让模型视角只增不减，压缩水位形同虚设。
# COMPACTION_TAIL_MESSAGES=0
# 单条工具输出的 token 上限（bound_tool_output 额外按 token 封顶，超限写盘 + 续读提示）
# [提速] 调小可压低工具结果在重发中的权重
# TOOL_OUTPUT_MAX_TOKENS=4000

# ===========================================
# Permission & workspace (aligned with opencode external_directory)
# ===========================================
# 免审范围只有三类：会话默认临时目录、程序内部数据目录、用户「工作目录白名单」
# （前端「用户设置 → 工作目录白名单」维护，持久化于 data/runtime_workspaces.json）。
# 其余路径（含 backend 源码与仓库根）一律人工审批；此处不再支持 EXTRA_WORKSPACES。
# [已废止] EXTERNAL_PATH_DEFAULT 不再影响决策（保留仅为兼容旧 .env）
# EXTERNAL_PATH_DEFAULT=ask
# 权限审批等待超时（秒），超时视为拒绝（默认 180；前端倒计时据此自动调整）
# PERMISSION_APPROVAL_TIMEOUT=180
# 是否放行主工作区内受保护源码路径（app/、plugins/、skills/、config/、main.py 等）的写/执行。
# 默认 false（这些路径硬保护，添加再多工作区也不能改）；开发本系统自身时设为 true 可让
# Agent 修改 backend 源码。.git、.env、*.db、permissions.json 始终保护，不受此开关影响。
# ALLOW_SOURCE_WRITES=false

# ===========================================
# Admin & CORS
# ===========================================
# 管理端接口（插件 toggle/call、权限审批、技能 toggle、摘要配置、工作区增删等）鉴权：
# 设置后要求请求头携带 Authorization: Bearer <token>；未设置时仅允许本机来源（127.0.0.1）调用，
# 局域网/公网远程访问将被 403 拒绝。建议部署到非本机时设置。
# ADMIN_TOKEN=your-admin-token
# CORS 允许的源（JSON 数组），默认仅本机 vite dev(5173)/preview(4173)。其他来源部署前端时按需添加。
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ===========================================
# Concurrency & SSRF & Auth
# ===========================================
# 全局同时执行的 Agent 任务上限（chat.py `_agent_semaphore`，多 Agent 请求排队），默认 4
# MAX_CONCURRENT_AGENTS=4
# 出站 HTTP 请求的 SSRF 防护：默认拦截私有/环回/链路本地/云元数据地址。
# 仅本地调试时设置为 true 放行内网（协议与格式校验仍生效）
# SSRF_ALLOW_INTERNAL=false
# 用户身份登录（账号/密码）。设置 AUTH_TOKEN_SECRET 后启用：
# 前端强制进入 /login 页面注册账号或登录，所有 /api/* 请求必须携带
# 与 X-User-Id 匹配的 X-Auth-Token，防局域网伪造身份越权。
# 未设置时全程匿名（X-User-Id = anonymous），不要求登录。
# AUTH_TOKEN_SECRET=your-secret
# token 有效期（秒，默认 2592000 = 30 天）
# AUTH_TOKEN_TTL=2592000
# 用户数据（账号哈希 / 设备密钥哈希）持久化文件
# AUTH_USERS_PATH=data/auth_users.json
# 共享记忆持久化路径（未过期记忆重启不丢失）
# MEMORY_PERSIST_PATH=data/agent_memory.json

#日志目录（默认 data/logs，需确保可写）
# AGENTSUPER_LOG_DIR=data/logs

# ── [F8/F9] 图片上传解析给模型 · caption 模型配置 ──
# 主对话模型为 DeepSeek（纯文本），图片「被模型看见」依赖
# caption 描述桥（视觉 LLM）。默认 openai/gpt-4o-mini（需 OPENAI_API_KEY）。
# 内网/离线环境改 Ollama 本地视觉模型（【不自动下载】，先用
# scripts/download_image_model.py 预下载，即 `ollama pull llava`）：
#   IMAGE_CAPTION_MODEL=ollama_chat/llava
#   IMAGE_CAPTION_API_BASE=http://localhost:11434
#   （Ollama 无需 API Key；litellm 的 ollama_chat/ 前缀路由到本地 Ollama）
IMAGE_CAPTION_MODEL=openai/gpt-4o-mini
IMAGE_CAPTION_API_BASE=
IMAGE_CAPTION_API_KEY=
IMAGE_VLM_CAPTION=true
IMAGE_USE_OCR=false
# 回显/缓存缩略图边长（px）
IMAGE_THUMBNAIL_PX=256
# OCR 引擎（IMAGE_USE_OCR=true 时）。留空则用系统 PATH 中的 tesseract 及其默认 tessdata。
# 若 tesseract 装在受保护目录（PATH 未含、tessdata 不可写），可显式指定：
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_DIR=<tessdata 目录，含 eng/chi_sim.traineddata>
# OCR_LANGUAGES=chi_sim+eng

# ── [语音/TTS] 本地内置模型（Qwen3-TTS 子进程，无外部 HTTP 接口调用）──
# 启用后：主 Agent 注册 tool_tts_synthesize / tool_voice_transcribe，
# 并提供 /api/voice/status|transcribe|tts 供前端录音/朗读（默认关闭）。
# 安装/预下载（一次性）：
#   pip install -r requirements-voice.txt
#   python scripts/download_tts_model.py            # TTS 合成模型（启动若缺也会后台自动下载）
#   python scripts/download_tts_model.py --whisper  # 转写（Whisper，不在启动自动下载）
VOICE_TTS_ENABLED=false
# 目录固定在 backend/ttsclone（不配置路径）。
# 默认音色 / 模型规格 / 单次合成超时（秒）
# 模型规格：交互默认 0.6B（本机 CPU 单句 ~5-17s）；1.7B ~38s 太慢，仅离线批量质检用。
VOICE_TTS_SPEAKER=Vivian
VOICE_TTS_MODEL_SIZE=0.6B
VOICE_TTS_TIMEOUT=600

# ── 补全：config.py 中存在但本文档此前未列出的配置项（默认值，取消注释即生效）──
# 可观测性链路日志（chainlog）
# CHAIN_LOG_ENABLED=true
# CHAIN_LOG_QUEUE_SIZE=5000
# CHAIN_LOG_FLUSH_BATCH=200
# CHAIN_LOG_FLUSH_INTERVAL=1.0
# CHAIN_LOG_MAX_ROWS=200000
# CHAIN_LOG_RETENTION_DAYS=7
# CHAIN_LOG_MAX_DATA_CHARS=4000
# CHAIN_LOG_TOOL_CALLS=true

# 模型下载容错
# MODEL_DOWNLOAD_TIMEOUT=600
# MODEL_DOWNLOAD_RETRIES=2
# token 估算校正系数（cognition/token_counter.py）
# TOKEN_ESTIMATE_CORRECTION=1.13
# 图片描述桥细节（IMAGE_VLM_CAPTION=false 时不生效）
# IMAGE_CAPTION_PROMPT=
# IMAGE_CAPTION_TIMEOUT=15

# ── 跨模型工具调用 Harness（harness/）──
# 全局强制工具调用路径：native | fallback
# 不设置时按模型目录能力探测；未知模型保守走 fallback。
# 注意：这是排障开关，开启后会强制影响所有模型，日常请保持注释。
# HARNESS_TOOL_MODE=fallback
# 额外声明模型能力（逗号分隔）；优先级：HARNESS_TOOL_MODE > FALLBACK_MODELS > NATIVE_MODELS > 目录探测
# HARNESS_NATIVE_MODELS=deepseek/deepseek-v4-flash,deepseek/deepseek-v4-pro
# HARNESS_FALLBACK_MODELS=ollama_chat/qwen3.5:4b

# ── 真实模型验收测试（仅 pytest 手动开启，日常保持注释，避免消耗真实 token）──
# 单模型验收：原生 tool_calls + 强制文本回退工具循环
# HARNESS_REAL_TEST=1
# HARNESS_REAL_MODEL=deepseek/deepseek-v4-flash
#
# L4 双真实模型切换：模型 A 记录事实 → 上下文摘要迁移 → 模型 B 必须召回
# L4_MODEL_SWITCH=1
# L4_MODEL_A=deepseek/deepseek-v4-flash
# L4_MODEL_B=deepseek/deepseek-v4-pro
# 可选：一次跑多组模型对（分号分隔，格式 A:B）；设置后覆盖 L4_MODEL_A/B。
# Ollama 标签本身含冒号（如 qwen3.5:4b）时建议改用 L4_MODEL_A/L4_MODEL_B。
# L4_MODEL_PAIRS=deepseek/deepseek-v4-flash:deepseek/deepseek-v4-pro

