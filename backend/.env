# ===========================================
# LLM Configuration
# ===========================================
# For DeepSeek:
#   LLM_MODEL=deepseek-chat
#   LLM_API_KEY=sk-your-deepseek-key
#   LLM_API_BASE=https://api.deepseek.com
#
# For OpenAI:
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_KEY=sk-your-openai-key
#   LLM_API_BASE=
#
# For Ollama (local):
#   LLM_MODEL=ollama/qwen2.5:7b
#   LLM_API_KEY=
#   LLM_API_BASE=http://localhost:11434
# ===========================================
LLM_MODEL=deepseek/deepseek-v4-pro
LLM_API_KEY=sk-720372110b52417a831059f6b0b144df
LLM_API_BASE=https://api.deepseek.com

# ===========================================
# Embedding Model Configuration
# (can use a different provider than the LLM)
# ===========================================
# Use a local sentence-transformers model path when available.
# If remote model access fails, the backend will try this local directory.
EMBEDDING_MODEL=data/models/all-MiniLM-L6-v2

# ===========================================
# RAG Configuration
# ===========================================
VECTOR_STORE_PATH=data/vector_store
UPLOAD_DIR=data/uploads
CHUNK_SIZE=500
CHUNK_OVERLAP=200

# ===========================================
# Reranker (disabled to avoid model download failure)
# ===========================================
ENABLE_RERANKER=false

# ===========================================
# Skills & Plugins
# ===========================================
SKILLS_DIR=skills
PLUGINS_DIR=plugins

# ===========================================
# TAVILY
# ===========================================
TAVILY_API_KEY=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

# ===========================================
# Summarization (optional)
# ===========================================
# SUMMARIZATION_MODEL=ollama/qwen2.5:3b
# SUMMARIZATION_KEEP_MESSAGES=20
# CHUNK_PAIRS=10